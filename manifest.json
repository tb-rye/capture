{
  "name": "Capture",
  "short_name": "Capture",
  "description": "One inbox for everything the family needs to remember, decide, or do.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F4F5F2",
  "theme_color": "#1E56A0",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "files", "accept": ["image/*", "audio/*", "application/pdf", "text/plain", "text/vcard"] }
      ]
    }
  },
  "shortcuts": [
    { "name": "Type a note", "url": "./index.html?quiet=1", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Recent", "url": "./index.html?quiet=1#recent", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ]
}
